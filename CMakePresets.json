{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_GENERATOR_PLATFORM": "x64"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "x64-release",
      "configurePreset": "x64",
      "configuration": "Release",
      "jobs": 8
    }
  ],

  "testPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64",
      "configuration": "Debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64",
      "configuration": "Release"
    }
  ]
}
